generator client {
  provider = "prisma-client-js"
}

// Prisma 7 : l'URL de connexion ne se déclare plus ici. Migrate/Studio la
// lisent depuis prisma.config.ts ; PrismaClient reçoit un `adapter` explicite
// au runtime (voir lib/db/client.ts et lib/db/system-client.ts).
datasource db {
  provider = "postgresql"
}

enum OrganizationPlan {
  STARTER
  BUSINESS
  PRO
  ENTERPRISE

  @@map("organization_plan")
}

enum OrganizationStatus {
  ACTIVE
  GRACE_PERIOD
  SUSPENDED

  @@map("organization_status")
}

enum UserRole {
  PROPRIETAIRE
  GERANT
  RESPONSABLE_STOCK
  VENDEUR
  COMPTABLE

  @@map("user_role")
}

enum StockMovementType {
  RECEPTION
  VENTE
  RETOUR_CLIENT
  RETOUR_FOURNISSEUR
  TRANSFERT_SORTANT
  TRANSFERT_ENTRANT
  AJUSTEMENT
  CASSE_PERTE_VOL
  CONSOMMATION_INTERNE

  @@map("stock_movement_type")
}

enum SaleStatus {
  VALIDEE
  ANNULEE

  @@map("sale_status")
}

enum PaymentMode {
  ESPECES
  MOBILE_MONEY
  CARTE
  VIREMENT
  ARDOISE
  BON_ACHAT

  @@map("payment_mode")
}

enum ImportBatchStatus {
  EN_ATTENTE
  COMMITE
  ANNULE

  @@map("import_batch_status")
}

enum CustomerLedgerType {
  VENTE_ARDOISE
  PAIEMENT
  AJUSTEMENT
  ANNULATION_VENTE
  // Paiement en caisse par bon d'achat (Phase 3, M21) : mécaniquement
  // identique à VENTE_ARDOISE (montant positif, consomme le solde du
  // client), distingué pour ne pas polluer les libellés "vente à crédit"
  // des rapports avec des rédemptions de fidélité.
  UTILISATION_BON_ACHAT

  @@map("customer_ledger_type")
}

enum LoyaltyLedgerType {
  GAGNE
  CONVERTI
  AJUSTEMENT

  @@map("loyalty_ledger_type")
}

enum PurchaseOrderStatus {
  BROUILLON
  ENVOYEE
  RECUE_PARTIELLE
  RECUE_COMPLETE
  ANNULEE

  @@map("purchase_order_status")
}

enum SupplierLedgerType {
  RECEPTION
  PAIEMENT
  AJUSTEMENT

  @@map("supplier_ledger_type")
}

enum ExpenseStatus {
  EN_ATTENTE
  VALIDEE
  REJETEE

  @@map("expense_status")
}

enum CashMovementType {
  APPRO
  PRELEVEMENT
  DEPOT_BANQUE

  @@map("cash_movement_type")
}

enum InventorySessionType {
  COMPLET
  PARTIEL

  @@map("inventory_session_type")
}

enum InventorySessionStatus {
  EN_COURS
  VALIDEE
  ANNULEE

  @@map("inventory_session_status")
}

enum StockTransferStatus {
  DEMANDE
  EXPEDIE
  RECU
  ANNULE

  @@map("stock_transfer_status")
}

enum SerialNumberStatus {
  EN_STOCK
  VENDU

  @@map("serial_number_status")
}

model Organization {
  id           String             @id @default(uuid()) @db.Uuid
  nom          String
  slug         String             @unique
  plan         OrganizationPlan   @default(STARTER)
  statut       OrganizationStatus @default(ACTIVE)
  devise       String             @default("XOF")
  fuseau       String             @default("Africa/Douala")
  profilMetier String             @default("generique") @map("profil_metier")
  settings     Json               @default("{}")
  // Marketplace de modules (Phase 4, M26) : tableau de clés (lib/tenant/modules.ts
  // MODULE_CATALOG), activé exclusivement par l'admin plateforme (jamais en
  // self-service) — même mécanique que plan/statut (M25).
  enabledModules Json             @default("[]") @map("enabled_modules")
  // White label — domaine personnalisé (Phase 4, M27). Colonnes réelles
  // (pas settings Json) : lues à CHAQUE requête entrante par proxy.ts avant
  // même la résolution de session, comme `slug` — doivent être indexées.
  // Disponibilité gouvernée par le plan (lib/tenant/entitlements.ts,
  // ENTERPRISE uniquement), pas par le marketplace de modules (M26) : c'est
  // un avantage de palier d'abonnement, pas un module payant à l'unité.
  customDomain                  String?   @unique @map("custom_domain")
  customDomainVerified          Boolean   @default(false) @map("custom_domain_verified")
  customDomainVerificationToken String?   @map("custom_domain_verification_token")
  customDomainVerifiedAt        DateTime? @map("custom_domain_verified_at")
  createdAt    DateTime           @default(now()) @map("created_at")

  shops      Shop[]
  users      User[]
  categories Category[]
  products   Product[]
  sales      Sale[]
  auditLogs  AuditLog[]
  stockMovements StockMovement[]
  stockAlerts    StockAlert[]
  importBatches  ImportBatch[]
  customers      Customer[]
  suppliers      Supplier[]
  platformPayments PlatformPayment[]
  branding         OrganizationBranding?
  onlineOrders     OnlineOrder[]

  @@map("organizations")
}

// Logo stocké en base (bytea), même précédent qu'Expense.justificatifData —
// séparé d'Organization (Phase 4, M27) pour ne jamais alourdir le
// organization.findUnique() relu à chaque page admin de chaque organisation.
// Consulté uniquement par la page de paramétrage white-label et par la
// route de service du logo (/api/branding/logo).
model OrganizationBranding {
  organizationId String  @id @map("organization_id") @db.Uuid
  logoData       Bytes?  @map("logo_data")
  logoMimeType   String? @map("logo_mime_type")

  organization Organization @relation(fields: [organizationId], references: [id])

  @@map("organization_branding")
}

// Espace admin plateforme (Phase 3, M25) : authentification et rôle
// entièrement séparés des organisations clientes — un opérateur côté
// Tacynt, jamais un Propriétaire de boutique qui se paierait à lui-même.
// Ni ce modèle ni PlatformAdminSession/PlatformPayment ne portent
// organization_id comme limite d'isolement au sens RLS : ce sont des vues
// délibérément cross-organisation. Isolation réelle = absence totale de
// policy RLS + absence de GRANT au rôle runtime applicatif (tacynt_app),
// posée à la main dans la migration (voir prisma/rls-manifest.sql) — seul
// le rôle propriétaire des migrations y accède, via lib/db/platform-client.ts,
// jamais lib/db/client.ts (le client tenant, RLS).
model PlatformAdmin {
  id        String   @id @default(uuid()) @db.Uuid
  email     String   @unique
  hash      String
  actif     Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  sessions PlatformAdminSession[]
  payments PlatformPayment[]

  @@map("platform_admins")
}

model PlatformAdminSession {
  id              String   @id @default(uuid()) @db.Uuid
  platformAdminId String   @map("platform_admin_id") @db.Uuid
  tokenHash       String   @unique @map("token_hash")
  expiresAt       DateTime @map("expires_at")
  ip              String?
  userAgent       String?  @map("user_agent")
  createdAt       DateTime @default(now()) @map("created_at")

  platformAdmin PlatformAdmin @relation(fields: [platformAdminId], references: [id])

  @@map("platform_admin_sessions")
}

// Constat manuel d'un paiement perçu hors ligne (section 9 : "c'est l'admin
// qui gère les abonnements après avoir perçu en espèces") — pas une
// transaction réelle, aucune intégration de paiement derrière.
model PlatformPayment {
  id                String   @id @default(uuid()) @db.Uuid
  organizationId    String   @map("organization_id") @db.Uuid
  montant           Decimal  @db.Decimal(12, 2)
  devise            String
  periodeDebut      DateTime @map("periode_debut")
  periodeFin        DateTime @map("periode_fin")
  recordedByAdminId String   @map("recorded_by_admin_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at")

  organization      Organization  @relation(fields: [organizationId], references: [id])
  recordedByAdmin   PlatformAdmin @relation(fields: [recordedByAdminId], references: [id])

  @@index([organizationId])
  @@map("platform_payments")
}

// Formulaire de contact de la landing page publique (app/page.tsx) —
// visiteur anonyme, aucun contexte tenant. Table cross-organisation comme
// PlatformAdmin/PlatformPayment ci-dessus : aucune policy RLS, aucun accès
// au rôle applicatif runtime (voir le bloc REVOKE de prisma/rls-manifest.sql),
// seul le rôle propriétaire (lib/db/platform-client.ts) y touche.
model ContactRequest {
  id        String   @id @default(uuid()) @db.Uuid
  nom       String
  email     String
  message   String
  traite    Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("contact_requests")
}

model Shop {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  nom            String
  adresse        String?
  telephone      String?
  actif          Boolean @default(true)

  organization   Organization    @relation(fields: [organizationId], references: [id])
  userShops      UserShop[]
  shopPrices     ShopPrice[]
  stockLevels    StockLevel[]
  stockMovements StockMovement[]
  sales          Sale[]
  cashSessions   CashSession[]
  registers      Register[]
  stockAlerts    StockAlert[]
  customerCategoryPrices CustomerCategoryPrice[]
  purchaseOrders PurchaseOrder[]
  goodsReceipts  GoodsReceipt[]
  expenses       Expense[]
  cashMovements  CashMovement[]
  inventorySessions InventorySession[]
  transfersEnvoyes  StockTransfer[] @relation("StockTransferFromShop")
  transfersRecus    StockTransfer[] @relation("StockTransferToShop")
  lots              Lot[]
  serialNumbers     SerialNumber[]
  onlineOrders      OnlineOrder[]

  @@index([organizationId])
  @@map("shops")
}

model User {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  email          String
  hash           String
  role           UserRole
  actif          Boolean   @default(true)
  mfaEnabled     Boolean   @default(false) @map("mfa_enabled")
  mfaSecret      String?   @map("mfa_secret")
  failedAttempts Int       @default(0) @map("failed_attempts")
  lockedUntil    DateTime? @map("locked_until")
  createdAt      DateTime  @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  userShops    UserShop[]
  sessions     Session[]

  @@unique([organizationId, email])
  @@index([organizationId])
  @@map("users")
}

model UserShop {
  // organization_id dénormalisé ici aussi : règle non négociable du cahier
  // des charges ("organization_id sur toutes les tables métier"), même sur
  // une table de jointure.
  organizationId String @map("organization_id") @db.Uuid
  userId         String @map("user_id") @db.Uuid
  shopId         String @map("shop_id") @db.Uuid

  user User @relation(fields: [userId], references: [id])
  shop Shop @relation(fields: [shopId], references: [id])

  @@id([userId, shopId])
  @@index([organizationId])
  @@map("user_shops")
}

model Session {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  tokenHash      String   @unique @map("token_hash")
  expiresAt      DateTime @map("expires_at")
  ip             String?
  userAgent      String?  @map("user_agent")
  createdAt      DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([organizationId])
  @@map("sessions")
}

model Category {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  parentId       String? @map("parent_id") @db.Uuid
  nom            String

  organization Organization @relation(fields: [organizationId], references: [id])
  parent       Category?    @relation("CategoryToCategory", fields: [parentId], references: [id])
  children     Category[]   @relation("CategoryToCategory")
  products     Product[]
  inventorySessions InventorySession[]

  @@index([organizationId])
  @@map("categories")
}

model Product {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  reference      String
  designation    String
  categoryId     String?  @map("category_id") @db.Uuid
  unite          String   @default("piece")
  tauxTaxe       Decimal  @default(0) @map("taux_taxe") @db.Decimal(5, 2)
  suiviStock     Boolean  @default(true) @map("suivi_stock")
  // Activable seulement si le profil métier de l'organisation le permet
  // (épicerie/pharmacie — section 6, Phase 3 M22). Sortie de stock en FEFO
  // quand actif ; lib/stock/lots.ts.
  suiviLots      Boolean  @default(false) @map("suivi_lots")
  // Activable seulement pour le profil "électronique" (section 6, Phase 3
  // M23). Traçabilité unité par unité, affectation à la vente en FIFO ;
  // lib/stock/serial-numbers.ts. Mutuellement exclusif de suiviLots en
  // pratique (aucun profil n'active les deux), jamais forcé par le schéma.
  suiviSerie     Boolean  @default(false) @map("suivi_serie")
  actif          Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization     @relation(fields: [organizationId], references: [id])
  category     Category?        @relation(fields: [categoryId], references: [id])
  variants     ProductVariant[]

  @@unique([organizationId, reference])
  @@index([organizationId])
  @@index([categoryId])
  @@map("products")
}

model ProductVariant {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  productId      String  @map("product_id") @db.Uuid
  attributs      Json    @default("{}")
  // Unique par organisation, pas globalement : deux boutiques différentes
  // (organisations distinctes) peuvent légitimement utiliser le même
  // code-barres interne. Une contrainte globale coupait à tort des données
  // qui n'ont aucune raison d'être liées entre tenants.
  codeBarres     String? @map("code_barres")
  prixAchatRef   Decimal @default(0) @map("prix_achat_ref") @db.Decimal(12, 2)
  // Une variante retirée ne se supprime pas (mouvements/lignes de vente
  // déjà rattachés) — même contrainte que Product.actif.
  actif          Boolean @default(true)

  product        Product         @relation(fields: [productId], references: [id])
  shopPrices     ShopPrice[]
  stockLevels    StockLevel[]
  stockMovements StockMovement[]
  saleLines      SaleLine[]
  stockAlerts    StockAlert[]
  customerCategoryPrices CustomerCategoryPrice[]
  lots               Lot[]
  serialNumbers      SerialNumber[]
  supplierProducts   SupplierProduct[]
  purchaseOrderLines PurchaseOrderLine[]
  goodsReceiptLines  GoodsReceiptLine[]
  inventoryCounts    InventoryCount[]
  stockTransferLines StockTransferLine[]
  onlineOrderLines   OnlineOrderLine[]

  @@unique([organizationId, codeBarres])
  @@index([organizationId])
  @@index([productId])
  @@map("product_variants")
}

model ShopPrice {
  organizationId String   @map("organization_id") @db.Uuid
  variantId      String   @map("variant_id") @db.Uuid
  shopId         String   @map("shop_id") @db.Uuid
  prixVente      Decimal  @map("prix_vente") @db.Decimal(12, 2)
  prixPlancher   Decimal? @map("prix_plancher") @db.Decimal(12, 2)
  // "Seuil d'alerte : entier, par boutique" (fiche produit, section 5.1) —
  // absent de l'extrait de modèle section 10, ajouté ici puisqu'il est
  // explicitement scopé par boutique comme le prix.
  seuilAlerte    Int?     @map("seuil_alerte")

  variant ProductVariant @relation(fields: [variantId], references: [id])
  shop    Shop           @relation(fields: [shopId], references: [id])

  @@id([variantId, shopId])
  @@index([organizationId])
  @@index([shopId])
  @@map("shop_prices")
}

// Projection de performance : reconstructible intégralement depuis
// stock_movements (scripts/reconstruct-stock.ts). Jamais la source de vérité.
model StockLevel {
  organizationId String  @map("organization_id") @db.Uuid
  variantId      String  @map("variant_id") @db.Uuid
  shopId         String  @map("shop_id") @db.Uuid
  quantite       Decimal @default(0) @db.Decimal(14, 3)
  cump           Decimal @default(0) @db.Decimal(14, 4)

  variant ProductVariant @relation(fields: [variantId], references: [id])
  shop    Shop           @relation(fields: [shopId], references: [id])

  @@id([variantId, shopId])
  @@index([organizationId])
  @@index([shopId])
  @@map("stock_levels")
}

// Journal immuable : aucune méthode d'update/delete dans le code applicatif.
// Une erreur se corrige par un mouvement inverse, jamais par une édition.
model StockMovement {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @map("organization_id") @db.Uuid
  shopId         String            @map("shop_id") @db.Uuid
  variantId      String            @map("variant_id") @db.Uuid
  type           StockMovementType
  // Signée : positif = entrée en stock, négatif = sortie. Le signe porte
  // toute l'information de sens — critère d'acceptation section 12 : "somme
  // des mouvements = stock affiché", un simple SUM(quantite) sans avoir à
  // recroiser avec `type`. Le CUMP ne se recalcule que sur les entrées
  // (quantite > 0) ; une sortie ne change jamais le CUMP.
  quantite       Decimal           @db.Decimal(14, 3)
  coutUnitaire   Decimal           @map("cout_unitaire") @db.Decimal(14, 4)
  documentType   String?           @map("document_type")
  documentId     String?           @map("document_id") @db.Uuid
  // Optionnel : renseigné uniquement pour un variant à suiviLots=true
  // (Phase 3, M22) — une sortie FEFO peut générer plusieurs mouvements pour
  // une même ligne de vente, un par lot consommé.
  lotId          String?           @map("lot_id") @db.Uuid
  userId         String?           @map("user_id") @db.Uuid
  motif          String?
  createdAt      DateTime          @default(now()) @map("created_at")

  organization Organization   @relation(fields: [organizationId], references: [id])
  shop         Shop           @relation(fields: [shopId], references: [id])
  variant      ProductVariant @relation(fields: [variantId], references: [id])
  lot          Lot?           @relation(fields: [lotId], references: [id])

  @@index([organizationId])
  @@index([shopId, variantId])
  @@map("stock_movements")
}

model Register {
  id                  String @id @default(uuid()) @db.Uuid
  organizationId      String @map("organization_id") @db.Uuid
  shopId              String @map("shop_id") @db.Uuid
  nom                 String
  // Préfixe court et stable des numéros de ticket ("C1", "C2"...) — les
  // plages sont allouées par poste, pas par boutique : sans préfixe propre à
  // chaque caisse, deux postes de la même boutique pourraient s'allouer des
  // plages numériques qui se chevauchent et produire le même numéro.
  code                String
  currentAllocatedMax BigInt @default(0) @map("current_allocated_max")

  shop         Shop          @relation(fields: [shopId], references: [id])
  cashSessions CashSession[]

  @@unique([shopId, code])
  @@index([organizationId])
  @@index([shopId])
  @@map("registers")
}

model CashSession {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  shopId         String    @map("shop_id") @db.Uuid
  registerId     String    @map("register_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  fondInitial    Decimal   @map("fond_initial") @db.Decimal(12, 2)
  compteFinal    Decimal?  @map("compte_final") @db.Decimal(12, 2)
  ecart          Decimal?  @db.Decimal(12, 2)
  openedAt       DateTime  @default(now()) @map("opened_at")
  closedAt       DateTime? @map("closed_at")

  shop          Shop           @relation(fields: [shopId], references: [id])
  register      Register       @relation(fields: [registerId], references: [id])
  sales         Sale[]
  expenses      Expense[]
  cashMovements CashMovement[]

  @@index([organizationId])
  @@index([shopId])
  @@map("cash_sessions")
}

model Sale {
  id             String     @id @default(uuid()) @db.Uuid
  organizationId String     @map("organization_id") @db.Uuid
  shopId         String     @map("shop_id") @db.Uuid
  numero         String
  uuidClient     String     @unique @map("uuid_client") @db.Uuid
  sessionId      String     @map("session_id") @db.Uuid
  customerId     String?    @map("customer_id") @db.Uuid
  totalHt        Decimal    @map("total_ht") @db.Decimal(14, 2)
  totalTaxe      Decimal    @map("total_taxe") @db.Decimal(14, 2)
  totalTtc       Decimal    @map("total_ttc") @db.Decimal(14, 2)
  statut         SaleStatus @default(VALIDEE)
  userId         String     @map("user_id") @db.Uuid
  createdAt      DateTime   @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  shop         Shop         @relation(fields: [shopId], references: [id])
  session      CashSession  @relation(fields: [sessionId], references: [id])
  customer     Customer?    @relation(fields: [customerId], references: [id])
  lines        SaleLine[]
  payments     Payment[]
  onlineOrder  OnlineOrder?

  @@unique([shopId, numero])
  @@index([organizationId])
  @@index([sessionId])
  @@map("sales")
}

model SaleLine {
  // organization_id/shop_id dénormalisés depuis la vente parente au moment
  // de l'insertion (jamais recalculés) : règle non négociable, policy RLS
  // simple sans jointure vers sales.
  organizationId   String  @map("organization_id") @db.Uuid
  shopId           String  @map("shop_id") @db.Uuid
  id               String  @id @default(uuid()) @db.Uuid
  saleId           String  @map("sale_id") @db.Uuid
  variantId        String  @map("variant_id") @db.Uuid
  quantite         Decimal @db.Decimal(14, 3)
  prixUnitaire     Decimal @map("prix_unitaire") @db.Decimal(12, 2)
  remise           Decimal @default(0) @db.Decimal(12, 2)
  coutUnitaireFige Decimal @map("cout_unitaire_fige") @db.Decimal(14, 4)

  sale    Sale           @relation(fields: [saleId], references: [id])
  variant ProductVariant @relation(fields: [variantId], references: [id])
  serialNumbers SerialNumber[]

  @@index([organizationId])
  @@index([saleId])
  @@map("sale_lines")
}

model Payment {
  organizationId String      @map("organization_id") @db.Uuid
  shopId         String      @map("shop_id") @db.Uuid
  id             String      @id @default(uuid()) @db.Uuid
  saleId         String      @map("sale_id") @db.Uuid
  mode           PaymentMode
  montant        Decimal     @db.Decimal(12, 2)
  reference      String?

  sale Sale @relation(fields: [saleId], references: [id])

  @@index([organizationId])
  @@index([saleId])
  @@map("payments")
}

enum OnlineOrderStatus {
  EN_ATTENTE
  CONFIRMEE
  PRETE
  RECUPEREE
  ANNULEE

  @@map("online_order_status")
}

enum OnlineOrderFulfillmentMode {
  RETRAIT_BOUTIQUE
  LIVRAISON

  @@map("online_order_fulfillment_mode")
}

// Commande en ligne (Phase 4, M30) : jamais une Sale — sale_id est une FK
// optionnelle vers une session de caisse physique qu'une commande en ligne
// n'a pas tant qu'elle n'est pas récupérée/encaissée en boutique (paiement
// au retrait/à la livraison, décision verrouillée Phase 4). Le stock n'est
// PAS décrémenté avant RECUPEREE : entre EN_ATTENTE/CONFIRMEE/PRETE la
// commande est purement informationnelle — même garantie que stock_transfers
// au statut DEMANDE, qui ne touche pas non plus le stock avant expédition.
model OnlineOrder {
  id               String                     @id @default(uuid()) @db.Uuid
  organizationId   String                     @map("organization_id") @db.Uuid
  shopId           String                     @map("shop_id") @db.Uuid
  numero           String
  customerId       String?                    @map("customer_id") @db.Uuid
  // Dénormalisés : identité de contact au moment de la commande, jamais
  // recalculés même si la fiche customer change ensuite — même règle que
  // sale_lines qui fige son propre coût.
  nomClient        String                     @map("nom_client")
  telephoneClient  String                     @map("telephone_client")
  modeRetrait      OnlineOrderFulfillmentMode @default(RETRAIT_BOUTIQUE) @map("mode_retrait")
  adresseLivraison String?                    @map("adresse_livraison")
  notes            String?
  statut           OnlineOrderStatus          @default(EN_ATTENTE)
  totalHt          Decimal                    @map("total_ht") @db.Decimal(14, 2)
  totalTaxe        Decimal                    @map("total_taxe") @db.Decimal(14, 2)
  totalTtc         Decimal                    @map("total_ttc") @db.Decimal(14, 2)
  // Renseigné uniquement au passage RECUPEREE : la vente réelle générée à
  // l'encaissement en boutique (lib/sales/apply-sale.ts, extrait de
  // processOneSale, M31). Une commande ne génère jamais plus d'une vente.
  saleId           String?                    @unique @map("sale_id") @db.Uuid
  createdAt        DateTime                   @default(now()) @map("created_at")
  confirmedAt      DateTime?                  @map("confirmed_at")
  cancelledAt      DateTime?                  @map("cancelled_at")

  organization Organization      @relation(fields: [organizationId], references: [id])
  shop         Shop              @relation(fields: [shopId], references: [id])
  customer     Customer?         @relation(fields: [customerId], references: [id])
  sale         Sale?             @relation(fields: [saleId], references: [id])
  lines        OnlineOrderLine[]

  @@unique([shopId, numero])
  @@index([organizationId])
  @@index([shopId])
  @@map("online_orders")
}

model OnlineOrderLine {
  organizationId String  @map("organization_id") @db.Uuid
  shopId         String  @map("shop_id") @db.Uuid
  id             String  @id @default(uuid()) @db.Uuid
  onlineOrderId  String  @map("online_order_id") @db.Uuid
  variantId      String  @map("variant_id") @db.Uuid
  quantite       Decimal @db.Decimal(14, 3)
  // Snapshot du prix affiché au client au moment de la commande — jamais
  // recalculé, même règle que sale_lines.prixUnitaire.
  prixUnitaire   Decimal @map("prix_unitaire") @db.Decimal(12, 2)
  remise         Decimal @default(0) @db.Decimal(12, 2)

  onlineOrder OnlineOrder    @relation(fields: [onlineOrderId], references: [id])
  variant     ProductVariant @relation(fields: [variantId], references: [id])

  @@index([organizationId])
  @@index([onlineOrderId])
  @@map("online_order_lines")
}

// Cas "stock négatif après resynchronisation" (cahier des charges 7.3) :
// la vente déjà encaissée n'est jamais annulée, on lève une alerte à traiter
// à l'inventaire.
model StockAlert {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  shopId         String    @map("shop_id") @db.Uuid
  variantId      String    @map("variant_id") @db.Uuid
  ecart          Decimal   @db.Decimal(14, 3)
  createdAt      DateTime  @default(now()) @map("created_at")
  resolvedAt     DateTime? @map("resolved_at")

  organization Organization   @relation(fields: [organizationId], references: [id])
  shop         Shop           @relation(fields: [shopId], references: [id])
  variant      ProductVariant @relation(fields: [variantId], references: [id])

  @@index([organizationId])
  @@map("stock_alerts")
}

// Deux temps (preview -> commit, section M12) : payload contient les lignes
// validées (JSON), jamais le fichier brut. Un lot déjà COMMITE ne se rejoue
// jamais — un nouvel import est un nouveau batch.
model ImportBatch {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @map("organization_id") @db.Uuid
  userId         String            @map("user_id") @db.Uuid
  statut         ImportBatchStatus @default(EN_ATTENTE)
  payload        Json
  resultat       Json?
  createdAt      DateTime          @default(now()) @map("created_at")
  committedAt    DateTime?         @map("committed_at")

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@map("import_batches")
}

model Customer {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  nom            String
  telephone      String?
  // Libre (pas un enum) : catégories tarifaires propres à chaque commerce,
  // pas de liste fermée imposée par le cahier des charges (section M13).
  categorieTarif String   @default("") @map("categorie_tarif")
  plafondCredit  Decimal  @default(0) @map("plafond_credit") @db.Decimal(12, 2)
  actif          Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")

  organization  Organization     @relation(fields: [organizationId], references: [id])
  sales         Sale[]
  ledgerEntries CustomerLedger[]
  loyaltyEntries LoyaltyLedger[]
  onlineOrders   OnlineOrder[]

  @@index([organizationId])
  @@map("customers")
}

// Journal append-only comme stock_movements/audit_logs : le solde d'un
// client est SUM(montant), jamais une colonne mutable — mêmes garanties de
// traçabilité qu'un mouvement de stock.
model CustomerLedger {
  id             String             @id @default(uuid()) @db.Uuid
  organizationId String             @map("organization_id") @db.Uuid
  customerId     String             @map("customer_id") @db.Uuid
  type           CustomerLedgerType
  // Signé : positif = le client doit plus (vente à crédit), négatif =
  // paiement/avoir qui réduit sa dette.
  montant        Decimal            @db.Decimal(12, 2)
  documentType   String?            @map("document_type")
  documentId     String?            @map("document_id") @db.Uuid
  userId         String?            @map("user_id") @db.Uuid
  motif          String?
  createdAt      DateTime           @default(now()) @map("created_at")

  customer Customer @relation(fields: [customerId], references: [id])

  @@index([organizationId])
  @@index([customerId])
  @@map("customer_ledger")
}

// Journal append-only, même moule que customer_ledger (Phase 3, M21) : le
// solde de points est SUM(points), jamais un compteur mutable. La
// conversion en crédit (CONVERTI) génère en parallèle une écriture
// customer_ledger — deux journaux séparés, jamais une seule "valeur" à
// synchroniser entre points et argent.
model LoyaltyLedger {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @map("organization_id") @db.Uuid
  customerId     String            @map("customer_id") @db.Uuid
  type           LoyaltyLedgerType
  // Signé : positif = points gagnés, négatif = points convertis/retirés.
  points         Int
  documentType   String?           @map("document_type")
  documentId     String?           @map("document_id") @db.Uuid
  createdAt      DateTime          @default(now()) @map("created_at")

  customer Customer @relation(fields: [customerId], references: [id])

  @@index([organizationId])
  @@index([customerId])
  @@map("loyalty_ledger")
}

// Surcouche optionnelle sur shop_prices (section M13) : prix spécifique à
// une catégorie tarifaire (ex. "Grossiste"), par variante et par boutique.
// Absent pour un triplet donné => on retombe sur shop_prices.prixVente.
model CustomerCategoryPrice {
  organizationId String  @map("organization_id") @db.Uuid
  variantId      String  @map("variant_id") @db.Uuid
  shopId         String  @map("shop_id") @db.Uuid
  categorieTarif String  @map("categorie_tarif")
  prixVente      Decimal @map("prix_vente") @db.Decimal(12, 2)

  variant ProductVariant @relation(fields: [variantId], references: [id])
  shop    Shop           @relation(fields: [shopId], references: [id])

  @@id([variantId, shopId, categorieTarif])
  @@index([organizationId])
  @@index([shopId])
  @@map("customer_category_prices")
}

model Supplier {
  id                  String   @id @default(uuid()) @db.Uuid
  organizationId      String   @map("organization_id") @db.Uuid
  nom                 String
  telephone           String?
  email               String?
  delaiLivraisonJours Int?     @map("delai_livraison_jours")
  actif               Boolean  @default(true)
  createdAt           DateTime @default(now()) @map("created_at")

  organization     Organization      @relation(fields: [organizationId], references: [id])
  supplierProducts SupplierProduct[]
  purchaseOrders   PurchaseOrder[]
  goodsReceipts    GoodsReceipt[]
  ledgerEntries    SupplierLedger[]

  @@index([organizationId])
  @@map("suppliers")
}

// Association fournisseur <-> variante (dernier prix d'achat connu,
// fournisseur préféré) — indépendante des commandes/réceptions, qui gardent
// chacune leur propre prix figé au moment de l'opération.
model SupplierProduct {
  organizationId   String  @map("organization_id") @db.Uuid
  supplierId       String  @map("supplier_id") @db.Uuid
  variantId        String  @map("variant_id") @db.Uuid
  prixAchatDernier Decimal @default(0) @map("prix_achat_dernier") @db.Decimal(12, 2)
  estPrefere       Boolean @default(false) @map("est_prefere")

  supplier Supplier       @relation(fields: [supplierId], references: [id])
  variant  ProductVariant @relation(fields: [variantId], references: [id])

  @@id([supplierId, variantId])
  @@index([organizationId])
  @@map("supplier_products")
}

model PurchaseOrder {
  id             String              @id @default(uuid()) @db.Uuid
  organizationId String              @map("organization_id") @db.Uuid
  shopId         String              @map("shop_id") @db.Uuid
  supplierId     String              @map("supplier_id") @db.Uuid
  numero         String
  statut         PurchaseOrderStatus @default(BROUILLON)
  userId         String              @map("user_id") @db.Uuid
  createdAt      DateTime            @default(now()) @map("created_at")

  supplier      Supplier            @relation(fields: [supplierId], references: [id])
  shop          Shop                @relation(fields: [shopId], references: [id])
  lines         PurchaseOrderLine[]
  goodsReceipts GoodsReceipt[]

  @@unique([organizationId, numero])
  @@index([organizationId])
  @@index([shopId])
  @@index([supplierId])
  @@map("purchase_orders")
}

model PurchaseOrderLine {
  // organization_id/shop_id dénormalisés depuis la commande parente au
  // moment de l'insertion — même règle que sale_lines/payments.
  organizationId       String  @map("organization_id") @db.Uuid
  shopId               String  @map("shop_id") @db.Uuid
  id                   String  @id @default(uuid()) @db.Uuid
  purchaseOrderId      String  @map("purchase_order_id") @db.Uuid
  variantId            String  @map("variant_id") @db.Uuid
  quantiteCommandee    Decimal @map("quantite_commandee") @db.Decimal(14, 3)
  prixUnitaireCommande Decimal @map("prix_unitaire_commande") @db.Decimal(12, 2)

  purchaseOrder PurchaseOrder  @relation(fields: [purchaseOrderId], references: [id])
  variant       ProductVariant @relation(fields: [variantId], references: [id])

  @@index([organizationId])
  @@index([purchaseOrderId])
  @@map("purchase_order_lines")
}

// purchaseOrderId optionnel : une réception peut être rattachée à une
// commande (suivi normal) ou être un achat spontané sans commande préalable.
model GoodsReceipt {
  id              String   @id @default(uuid()) @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  shopId          String   @map("shop_id") @db.Uuid
  supplierId      String   @map("supplier_id") @db.Uuid
  purchaseOrderId String?  @map("purchase_order_id") @db.Uuid
  numero          String
  userId          String   @map("user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")

  supplier      Supplier           @relation(fields: [supplierId], references: [id])
  shop          Shop               @relation(fields: [shopId], references: [id])
  purchaseOrder PurchaseOrder?     @relation(fields: [purchaseOrderId], references: [id])
  lines         GoodsReceiptLine[]

  @@unique([organizationId, numero])
  @@index([organizationId])
  @@index([shopId])
  @@index([supplierId])
  @@map("goods_receipts")
}

model GoodsReceiptLine {
  organizationId   String  @map("organization_id") @db.Uuid
  shopId           String  @map("shop_id") @db.Uuid
  id               String  @id @default(uuid()) @db.Uuid
  goodsReceiptId   String  @map("goods_receipt_id") @db.Uuid
  variantId        String  @map("variant_id") @db.Uuid
  quantiteRecue    Decimal @map("quantite_recue") @db.Decimal(14, 3)
  prixUnitaireRecu Decimal @map("prix_unitaire_recu") @db.Decimal(12, 2)

  goodsReceipt GoodsReceipt   @relation(fields: [goodsReceiptId], references: [id])
  variant      ProductVariant @relation(fields: [variantId], references: [id])

  @@index([organizationId])
  @@index([goodsReceiptId])
  @@map("goods_receipt_lines")
}

// Journal append-only comme customer_ledger : le solde dû à un fournisseur
// est SUM(montant), jamais une colonne mutable.
model SupplierLedger {
  id             String             @id @default(uuid()) @db.Uuid
  organizationId String             @map("organization_id") @db.Uuid
  supplierId     String             @map("supplier_id") @db.Uuid
  type           SupplierLedgerType
  // Signé : positif = on doit plus au fournisseur (réception), négatif =
  // paiement qui réduit la dette.
  montant        Decimal            @db.Decimal(12, 2)
  documentType   String?            @map("document_type")
  documentId     String?            @map("document_id") @db.Uuid
  userId         String?            @map("user_id") @db.Uuid
  motif          String?
  createdAt      DateTime           @default(now()) @map("created_at")

  supplier Supplier @relation(fields: [supplierId], references: [id])

  @@index([organizationId])
  @@index([supplierId])
  @@map("supplier_ledger")
}

// Le justificatif (photo) est stocké directement en base (bytea) : aucune
// infra cloud à configurer, l'isolation tenant est héritée gratuitement de
// RLS (un expenseId d'une autre organisation n'existe simplement pas dans
// la requête). Migration vers S3 plus tard = changer une seule route.
model Expense {
  id                   String        @id @default(uuid()) @db.Uuid
  organizationId       String        @map("organization_id") @db.Uuid
  shopId               String        @map("shop_id") @db.Uuid
  categorie            String
  montant              Decimal       @db.Decimal(12, 2)
  modePaiement         PaymentMode   @map("mode_paiement")
  cashSessionId        String?       @map("cash_session_id") @db.Uuid
  statut               ExpenseStatus @default(EN_ATTENTE)
  justificatifData     Bytes?        @map("justificatif_data")
  justificatifMimeType String?       @map("justificatif_mime_type")
  userId               String        @map("user_id") @db.Uuid
  approvedByUserId     String?       @map("approved_by_user_id") @db.Uuid
  approvedAt           DateTime?     @map("approved_at")
  createdAt            DateTime      @default(now()) @map("created_at")

  shop        Shop         @relation(fields: [shopId], references: [id])
  cashSession CashSession? @relation(fields: [cashSessionId], references: [id])

  @@index([organizationId])
  @@index([shopId])
  @@map("expenses")
}

// Entrées/sorties de caisse hors vente (approvisionnement, prélèvement,
// dépôt banque) — montant toujours positif, le signe est porté par `type`
// dans la formule de rapprochement (sessions/[sessionId]/close/route.ts).
model CashMovement {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  shopId         String           @map("shop_id") @db.Uuid
  cashSessionId  String           @map("cash_session_id") @db.Uuid
  type           CashMovementType
  montant        Decimal          @db.Decimal(12, 2)
  motif          String
  userId         String           @map("user_id") @db.Uuid
  createdAt      DateTime         @default(now()) @map("created_at")

  shop        Shop        @relation(fields: [shopId], references: [id])
  cashSession CashSession @relation(fields: [cashSessionId], references: [id])

  @@index([organizationId])
  @@index([shopId])
  @@index([cashSessionId])
  @@map("cash_movements")
}

// La boutique continue de vendre pendant l'inventaire (section M16) : la
// session ne fait que définir le périmètre (COMPLET ou PARTIEL par
// catégorie), jamais un instantané figé de tout le stock à l'ouverture.
model InventorySession {
  id             String                  @id @default(uuid()) @db.Uuid
  organizationId String                  @map("organization_id") @db.Uuid
  shopId         String                  @map("shop_id") @db.Uuid
  type           InventorySessionType
  categoryId     String?                 @map("category_id") @db.Uuid
  statut         InventorySessionStatus  @default(EN_COURS)
  userId         String                  @map("user_id") @db.Uuid
  createdAt      DateTime                @default(now()) @map("created_at")
  validatedAt    DateTime?               @map("validated_at")

  shop     Shop              @relation(fields: [shopId], references: [id])
  category Category?         @relation(fields: [categoryId], references: [id])
  counts   InventoryCount[]

  @@index([organizationId])
  @@index([shopId])
  @@map("inventory_sessions")
}

// Une ligne n'existe qu'une fois comptée : quantite_theorique/cump_au_comptage
// sont figés au moment précis du comptage de CETTE ligne (lecture de
// stock_levels à cet instant), pas à l'ouverture de la session — d'où leur
// caractère NOT NULL, contrairement à quantite_comptee (qui pourrait en
// théorie rester vide sur un flux en deux temps futur).
model InventoryCount {
  id                 String    @id @default(uuid()) @db.Uuid
  organizationId     String    @map("organization_id") @db.Uuid
  shopId             String    @map("shop_id") @db.Uuid
  inventorySessionId String    @map("inventory_session_id") @db.Uuid
  variantId          String    @map("variant_id") @db.Uuid
  quantiteTheorique  Decimal   @map("quantite_theorique") @db.Decimal(14, 3)
  quantiteComptee    Decimal?  @map("quantite_comptee") @db.Decimal(14, 3)
  cumpAuComptage     Decimal   @map("cump_au_comptage") @db.Decimal(14, 4)
  comptePar          String?   @map("compte_par") @db.Uuid
  comptedAt          DateTime? @map("compted_at")

  inventorySession InventorySession @relation(fields: [inventorySessionId], references: [id])
  variant          ProductVariant   @relation(fields: [variantId], references: [id])

  @@unique([inventorySessionId, variantId])
  @@index([organizationId])
  @@index([inventorySessionId])
  @@map("inventory_counts")
}

// Flux en trois temps (section 5.2, Phase 3 M19) : demande -> expédition
// (sortie du stock émetteur) -> réception (entrée dans le stock
// destinataire, écart possible constaté, jamais silencieux). Touche deux
// boutiques à la fois — cas particulier dans le modèle RLS, policy dédiée
// dans prisma/rls-manifest.sql plutôt que le groupe générique à un seul
// shop_id.
model StockTransfer {
  id             String               @id @default(uuid()) @db.Uuid
  organizationId String               @map("organization_id") @db.Uuid
  fromShopId     String               @map("from_shop_id") @db.Uuid
  toShopId       String               @map("to_shop_id") @db.Uuid
  numero         String
  statut         StockTransferStatus  @default(DEMANDE)
  userId         String               @map("user_id") @db.Uuid
  createdAt      DateTime             @default(now()) @map("created_at")

  fromShop Shop                @relation("StockTransferFromShop", fields: [fromShopId], references: [id])
  toShop   Shop                @relation("StockTransferToShop", fields: [toShopId], references: [id])
  lines    StockTransferLine[]

  @@unique([organizationId, numero])
  @@index([organizationId])
  @@index([fromShopId])
  @@index([toShopId])
  @@map("stock_transfers")
}

model StockTransferLine {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  // Dénormalisés depuis le transfert parent, même règle que sale_lines —
  // les deux sont nécessaires pour la policy RLS dédiée (visible depuis
  // l'une ou l'autre boutique).
  fromShopId     String  @map("from_shop_id") @db.Uuid
  toShopId       String  @map("to_shop_id") @db.Uuid
  stockTransferId String @map("stock_transfer_id") @db.Uuid
  variantId      String  @map("variant_id") @db.Uuid
  quantiteDemandee       Decimal  @map("quantite_demandee") @db.Decimal(14, 3)
  // Figés au moment de l'expédition : le coût hérité par la boutique
  // destinataire est celui, réel, de la boutique émettrice — jamais un prix
  // d'achat arbitraire.
  quantiteExpediee       Decimal? @map("quantite_expediee") @db.Decimal(14, 3)
  coutUnitaireExpedition Decimal? @map("cout_unitaire_expedition") @db.Decimal(14, 4)
  quantiteRecue          Decimal? @map("quantite_recue") @db.Decimal(14, 3)

  stockTransfer StockTransfer  @relation(fields: [stockTransferId], references: [id])
  variant       ProductVariant @relation(fields: [variantId], references: [id])

  @@index([organizationId])
  @@index([stockTransferId])
  @@map("stock_transfer_lines")
}

// Lots et péremption (section 5.1, Phase 3 M22) : activable par profil
// métier (épicerie/pharmacie, lib/tenant/profile.ts). Un lot porte un
// numéro, une date de péremption optionnelle et une quantité — décrémentée
// directement ici par la consommation FEFO (lib/stock/lots.ts), pas
// reconstruite depuis les mouvements comme stock_levels : contrairement au
// stock total, il n'y a pas de risque de divergence puisque seule la
// consommation FEFO écrit cette quantité (jamais le formulaire de réception
// directement, jamais une vente hors-FEFO).
model Lot {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  shopId         String    @map("shop_id") @db.Uuid
  variantId      String    @map("variant_id") @db.Uuid
  numero         String
  datePeremption DateTime? @map("date_peremption")
  quantite       Decimal   @db.Decimal(14, 3)
  createdAt      DateTime  @default(now()) @map("created_at")

  shop      Shop            @relation(fields: [shopId], references: [id])
  variant   ProductVariant  @relation(fields: [variantId], references: [id])
  movements StockMovement[]

  @@unique([variantId, shopId, numero])
  @@index([organizationId])
  @@index([shopId])
  @@map("lots")
}

// Traçabilité unité par unité pour le profil "électronique" (section 6,
// Phase 3 M23) : contrairement aux lots (une quantité par lot), chaque ligne
// est une unité physique précise, créée à la réception. L'affectation à la
// vente se fait automatiquement en FIFO (lib/stock/serial-numbers.ts) — la
// caisse hors ligne ne scanne pas de numéro au point de vente, seule la
// traçabilité après-coup (recherche par numéro, support garantie) est
// exigée par le cahier des charges.
model SerialNumber {
  id             String             @id @default(uuid()) @db.Uuid
  organizationId String             @map("organization_id") @db.Uuid
  shopId         String             @map("shop_id") @db.Uuid
  variantId      String             @map("variant_id") @db.Uuid
  numero         String
  statut         SerialNumberStatus @default(EN_STOCK)
  saleLineId     String?            @map("sale_line_id") @db.Uuid
  receivedAt     DateTime           @default(now()) @map("received_at")
  soldAt         DateTime?          @map("sold_at")

  shop     Shop           @relation(fields: [shopId], references: [id])
  variant  ProductVariant @relation(fields: [variantId], references: [id])
  saleLine SaleLine?      @relation(fields: [saleLineId], references: [id])

  // Unique par organisation, pas par boutique : un numéro de série
  // matérielle identifie une unité physique unique, quelle que soit la
  // boutique où elle a été reçue (cf. la même règle pour codeBarres).
  @@unique([organizationId, numero])
  @@index([organizationId])
  @@index([shopId])
  @@index([variantId, shopId, statut])
  @@map("serial_numbers")
}

// Append-only : aucune méthode d'update/delete côté code (lib/audit.ts).
model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  userId         String?  @map("user_id") @db.Uuid
  action         String
  entite         String
  entiteId       String?  @map("entite_id") @db.Uuid
  avant          Json?
  apres          Json?
  ip             String?
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@map("audit_logs")
}
