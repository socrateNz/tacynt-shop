# Gabarit pour /opt/tacynt-shop/.env.production sur le serveur — jamais
# commité avec de vraies valeurs (voir .gitignore). Chargé par
# `docker compose -f docker-compose.prod.yml --env-file .env.production ...`
# (docs/deployment.md).

# Générés une fois avec ex. `openssl rand -base64 32` — jamais réutiliser un
# mot de passe de dev. scripts/ensure-runtime-role-password.ts aligne le mot
# de passe réel des rôles Postgres sur ces valeurs à chaque déploiement (la
# toute première migration crée tacynt_app avec un mot de passe de dev codé
# en dur, à corriger ainsi plutôt qu'en éditant la migration).
POSTGRES_OWNER_PASSWORD="CHANGE_ME"
POSTGRES_APP_PASSWORD="CHANGE_ME"

# Rôle propriétaire des migrations — bypass RLS, réservé à `prisma migrate`
# et aux scripts système. Doit correspondre à POSTGRES_OWNER_PASSWORD.
DATABASE_URL="postgresql://tacynt_owner:CHANGE_ME@postgres:5432/tacynt_shop?schema=public"

# Rôle applicatif runtime — soumis à RLS (FORCE ROW LEVEL SECURITY). Doit
# correspondre à POSTGRES_APP_PASSWORD.
RUNTIME_DATABASE_URL="postgresql://tacynt_app:CHANGE_ME@postgres:5432/tacynt_shop?schema=public"

# Domaine racine applicatif — {organisation}.shop.tacynt.com par boutique
# (cahier des charges section 14, sous-domaine cohérent avec money.tacynt.com).
APP_ROOT_DOMAIN="shop.tacynt.com"
