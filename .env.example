# Rôle propriétaire des migrations — bypass RLS, réservé à `prisma migrate`
# et aux scripts système (bootstrap d'inscription, reconstruction du stock).
DATABASE_URL="postgresql://tacynt_owner:CHANGE_ME@localhost:5432/tacynt_shop?schema=public"

# Rôle applicatif runtime — non-owner, soumis à RLS (FORCE ROW LEVEL SECURITY).
# Créé par la migration rls_policies (jalon M1). Toute requête tenant-scopée
# doit passer par ce rôle, jamais par DATABASE_URL.
RUNTIME_DATABASE_URL="postgresql://tacynt_app:CHANGE_ME@localhost:5432/tacynt_shop?schema=public"

# Domaine racine servant à résoudre le sous-domaine tenant dans proxy.ts.
# En local : localhost:3000 (accepte {slug}.localhost:3000 nativement).
APP_ROOT_DOMAIN="localhost:3000"
